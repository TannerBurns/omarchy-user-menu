#!/usr/bin/env bash
# user-menu-probe: read-only collector for the tannerburns.user-menu bar widget.
#
# Prints exactly one JSON document on stdout and always exits 0.
#
#   user-menu-probe [--section user,session,accounts,security|all]
#   user-menu-probe --provider <id>     one provider's account rows (JSON lines)
#   user-menu-probe --security <id>     one security fragment (JSON object)
#
# PRIVACY CONTRACT (keep it when you edit this file):
#   1. Credential files are read through jq with explicit identity paths only.
#      Whether a secret exists is checked by type, e.g. (.x.refreshToken|type),
#      never by reading it.
#   2. JWTs are decoded inside python3 -I from the payload segment, and only an
#      allowlist of claims (email, plan type, renewal date) is printed.
#   3. Token files (docker auth, HF token, gcloud credential DBs, Gemini OAuth)
#      are only tested for existence or section headers.
#   4. Error text from other tools never reaches the output.
#   5. A fail-closed guard scans the final document for token-shaped strings
#      and prints {"error":"redaction-guard"} instead if anything matches.
#   6. No CLI that can touch the network or install software is run
#      (gh, claude, codex, gemini, secret-tool search).
#
# Test hooks (environment): USER_MENU_NOW_MS, USER_MENU_EXPIRING_DAYS,
# USER_MENU_PROVIDER_TIMEOUT, USER_MENU_PROVIDERS (comma-separated allowlist).

set -uo pipefail
umask 077
export LC_ALL=C

PROBE_VERSION="0.2.0"
SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
NOW_MS=${USER_MENU_NOW_MS:-$(date +%s%3N)}
EXPIRING_DAYS=${USER_MENU_EXPIRING_DAYS:-7}
EXP_MS=$(( EXPIRING_DAYS * 86400000 ))
PROVIDER_TIMEOUT=${USER_MENU_PROVIDER_TIMEOUT:-3}
CFG=${XDG_CONFIG_HOME:-$HOME/.config}
USERNAME=${USER:-$(id -un 2>/dev/null)}

PROVIDERS=(git github gitlab google gemini microsoft
           claude openai copilot cursor opencode huggingface
           aws azure vercel netlify cloudflare fly heroku firebase supabase npm terraform docker tailscale
           slack spotify steam dropbox nextcloud
           1password bitwarden)
SECURITY=(ssh gpg keyring fingerprint admin)

have() { command -v "$1" >/dev/null 2>&1; }

# first_file <path...>: print the first existing regular file (native, Flatpak, Snap order).
first_file() {
  local f
  for f in "$@"; do
    if [[ -f $f ]]; then printf '%s' "$f"; return 0; fi
  done
  return 1
}

# ---------------------------------------------------------------- helpers

# row <provider> <name> <source> <identity> <plan> <status> [expiresMs] [note]
row() {
  jq -nc --arg provider "$1" --arg name "$2" --arg source "$3" --arg identity "$4" \
    --arg plan "$5" --arg status "$6" --arg exp "${7:-}" --arg note "${8:-}" \
    '{id: ($provider + ":" + $identity), provider: $provider, name: $name, source: $source,
      identity: $identity, plan: $plan, status: $status,
      expiresEpochMs: ($exp | if test("^[0-9]+$") then tonumber else null end), note: $note}'
}

# expiry_status <epochMs|""> → connected | expiring | expired
expiry_status() {
  local e=${1:-}
  if [[ ! $e =~ ^[0-9]+$ ]]; then echo connected; return; fi
  if (( e <= NOW_MS )); then echo expired; return; fi
  if (( e - NOW_MS <= EXP_MS )); then echo expiring; return; fi
  echo connected
}

# iso_to_ms <iso-8601> → epoch ms, or empty
iso_to_ms() {
  [[ -n ${1:-} ]] || return 0
  local s
  s=$(date -d "$1" +%s%3N 2>/dev/null) && echo "$s"
}

# Strip surrounding quotes and whitespace from a YAML/INI scalar.
unquote() {
  local v=${1:-}
  v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  v=${v#\"}; v=${v%\"}; v=${v#\'}; v=${v%\'}
  printf '%s' "$v"
}

# ini_value <file> <section> <key>
ini_value() {
  awk -v want="[$2]" -v key="$3" '
    /^[[:space:]]*\[/ { s=$0; gsub(/[[:space:]]/, "", s); insec = (s == want); next }
    insec {
      line=$0; sub(/^[[:space:]]+/, "", line)
      if (index(line, key) == 1) {
        rest=substr(line, length(key) + 1); sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
        if (rest != substr(line, length(key) + 1)) { print rest; exit }
      }
    }' "$1" 2>/dev/null
}

# browser_profiles <Local State> → "user_name<TAB>profile name" lines (signed-in only)
browser_profiles() {
  jq -r '.profile.info_cache // {} | to_entries[]
         | select((.value.user_name // "") != "")
         | [.value.user_name, (.value.name // .key)] | @tsv' "$1" 2>/dev/null
}

# ---------------------------------------------------------------- user

full_name_from_gecos() {
  local gecos
  gecos=$(getent passwd "$USERNAME" 2>/dev/null | cut -d: -f5 | cut -d, -f1)
  printf '%s' "$gecos"
}

git_global() { (cd "$HOME" 2>/dev/null && git config --global --get "$1" 2>/dev/null) || true; }

section_user() {
  local uid host gecos full source git_name="" git_email="" avatar="" shell groups
  uid=$(id -u 2>/dev/null || echo -1)
  host=${HOSTNAME:-}
  [[ -n $host ]] || host=$(cat /proc/sys/kernel/hostname 2>/dev/null || uname -n)
  if have git; then git_name=$(git_global user.name); git_email=$(git_global user.email); fi

  gecos=$(full_name_from_gecos)
  if [[ -n $gecos ]]; then full=$gecos; source=gecos
  elif [[ -n $git_name ]]; then full=$git_name; source=git
  else full=$USERNAME; source=username
  fi

  local f
  for f in "$HOME/.face" "$HOME/.face.icon" "/var/lib/AccountsService/icons/$USERNAME"; do
    if [[ -f $f && -r $f && -s $f ]]; then avatar=$f; break; fi
  done

  shell=$(getent passwd "$USERNAME" 2>/dev/null | cut -d: -f7)
  groups=$(id -nG "$USERNAME" 2>/dev/null || true)

  jq -nc --arg username "$USERNAME" --arg uid "$uid" --arg host "$host" --arg full "$full" \
    --arg source "$source" --arg avatar "$avatar" --arg shell "${shell:-${SHELL:-}}" \
    --arg home "$HOME" --arg groups "$groups" --arg gn "$git_name" --arg ge "$git_email" '
    def initials:
      (split(" ") | map(select(length > 0))) as $w
      | if ($w | length) >= 2 then ($w[0][0:1] + $w[-1][0:1])
        elif ($w | length) == 1 then $w[0][0:2]
        else "?" end
      | ascii_upcase;
    {username: $username, uid: ($uid | tonumber? // -1), host: $host,
     fullName: $full, fullNameSource: $source, initials: ($full | initials),
     avatar: $avatar, shell: $shell, home: $home,
     groups: ($groups | split(" ") | map(select(length > 0))),
     git: {name: $gn, email: $ge}}'
}

# ---------------------------------------------------------------- session

login1_get() { busctl --json=short get-property org.freedesktop.login1 "$@" 2>/dev/null; }

session_path() {
  local p
  p=$(login1_get /org/freedesktop/login1/user/self org.freedesktop.login1.User Display | jq -r '.data[1] // empty' 2>/dev/null)
  if [[ -n $p && $p != "/" ]]; then echo "$p"; return; fi
  if [[ -n ${XDG_SESSION_ID:-} ]]; then
    p=$(busctl --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
          org.freedesktop.login1.Manager GetSession s "$XDG_SESSION_ID" 2>/dev/null | jq -r '.data[0] // empty' 2>/dev/null)
    if [[ -n $p ]]; then echo "$p"; return; fi
  fi
  if login1_get /org/freedesktop/login1/session/auto org.freedesktop.login1.Session Id >/dev/null; then
    echo /org/freedesktop/login1/session/auto; return
  fi
  local id
  id=$(loginctl list-sessions --json=short 2>/dev/null \
        | jq -r --arg u "$USERNAME" '[.[] | select(.user == $u and .class == "user" and (.seat // "") != "")][0].session // empty' 2>/dev/null)
  [[ -n $id ]] && busctl --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager GetSession s "$id" 2>/dev/null | jq -r '.data[0] // empty' 2>/dev/null
}

previous_login() { # <current login epoch ms> → {"epochMs":…,"tty":…} or null
  local current=$1 tty iso ms
  if have last; then
    # Console logins only (ttyN); pts/* lines are terminal windows.
    while IFS=$'\t' read -r tty iso; do
      ms=$(iso_to_ms "$iso")
      [[ -n $ms ]] || continue
      if [[ ! $current =~ ^[0-9]+$ ]] || (( ms < current - 60000 )); then
        jq -nc --arg ms "$ms" --arg tty "$tty" '{epochMs: ($ms | tonumber), tty: $tty}'
        return
      fi
    done < <(last --time-format iso -w "$USERNAME" 2>/dev/null | awk '
      $2 ~ /^tty[0-9]+$/ && match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:?[0-9]{2}/) {
        printf "%s\t%s\n", $2, substr($0, RSTART, RLENGTH)
      }')
  fi
  echo null
}

section_session() {
  local path props uptime_s boot_ms
  uptime_s=$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo 0)
  boot_ms=$(awk -v now="$NOW_MS" -v up="$uptime_s" 'BEGIN { printf "%d", now - up * 1000 }')

  path=$(session_path)
  props=null
  if [[ -n $path ]]; then
    props=$(login1_get "$path" org.freedesktop.login1.Session \
              Id Timestamp Type Class Service TTY Seat Remote RemoteHost Desktop VTNr State \
            | jq -sc 'if length == 12 then map(.data) else null end' 2>/dev/null)
    [[ -n $props ]] || props=null
  fi

  local login_ms
  login_ms=$(jq -r 'if . == null then "" else (.[1] / 1000 | floor | tostring) end' <<<"$props" 2>/dev/null)
  local prev
  prev=$(previous_login "$login_ms")

  jq -nc --argjson p "$props" --arg boot "$boot_ms" --argjson prev "$prev" \
    --arg desktop "${XDG_CURRENT_DESKTOP:-}" '
    if $p == null then
      {available: false, id: "", loginEpochMs: null, type: "", class: "", desktop: $desktop,
       service: "", autologin: false, greeter: "", seat: "", tty: "", vt: null,
       remote: false, remoteHost: "", state: "", bootEpochMs: ($boot | tonumber), previousLogin: $prev}
    else
      {available: true, id: $p[0], loginEpochMs: ($p[1] / 1000 | floor), type: $p[2], class: $p[3],
       desktop: (if $desktop != "" then $desktop else $p[9] end),
       service: $p[4], autologin: ($p[4] | test("autologin")),
       greeter: ($p[4] | sub("-autologin$"; "") | sub("-greeter$"; "")),
       seat: ($p[6][0] // ""), tty: $p[5], vt: (if $p[10] > 0 then $p[10] else null end),
       remote: $p[7], remoteHost: $p[8], state: $p[11],
       bootEpochMs: ($boot | tonumber), previousLogin: $prev}
    end'
}

# ---------------------------------------------------------------- providers

provider_git() {
  have git || return 0
  local name email
  name=$(git_global user.name); email=$(git_global user.email)
  if [[ -n $name || -n $email ]]; then
    local identity=$email
    [[ -n $identity ]] || identity=$name
    row git Git "git config" "$identity" "" connected "" "$name"
  elif [[ -f $HOME/.gitconfig || -f $CFG/git/config ]]; then
    row git Git "git config" "" "" signed-out "" "No user.name or user.email set"
  fi
}

provider_github() {
  local dir=${GH_CONFIG_DIR:-$CFG/gh} hosts
  hosts="$dir/hosts.yml"
  if [[ -f $hosts ]]; then
    local found=0 host user plain
    while IFS=$'\t' read -r host user plain; do
      [[ -n $host ]] || continue
      found=1
      user=$(unquote "$user")
      local note=""
      [[ $plain == 1 ]] && note="Token stored in plain text in hosts.yml"
      if [[ -n $user ]]; then
        row github GitHub "gh CLI · $host" "$user" "" connected "" "$note"
      else
        row github GitHub "gh CLI · $host" "" "" signed-out "" ""
      fi
    done < <(awk '
      /^[^[:space:]#][^:]*:[[:space:]]*$/ { h=$0; sub(/:[[:space:]]*$/, "", h); hosts[++n]=h; cur=h; next }
      /^    user:/ { v=$0; sub(/^    user:[[:space:]]*/, "", v); user[cur]=v; next }
      /^    oauth_token:/ { tok[cur]=1; next }
      END { for (i = 1; i <= n; i++) { h=hosts[i]; printf "%s\t%s\t%s\n", h, user[h], (tok[h] ? 1 : 0) } }
    ' "$hosts" 2>/dev/null)
    (( found )) && return 0
  fi
  if [[ -d $dir ]]; then row github GitHub "gh CLI" "" "" signed-out "" ""; fi
}

provider_gitlab() {
  local cfg="$CFG/glab-cli/config.yml"
  [[ -f $cfg ]] || return 0
  local found=0 host user
  while IFS=$'\t' read -r host user; do
    [[ -n $host ]] || continue
    user=$(unquote "$user")
    [[ -n $user ]] || continue
    found=1
    row gitlab GitLab "glab CLI · $host" "$user" "" connected "" ""
  done < <(awk '
    /^hosts:/ { inhosts=1; next }
    /^[^[:space:]#]/ { inhosts=0 }
    inhosts && /^    [^[:space:]#][^:]*:[[:space:]]*$/ { h=$0; sub(/^    /, "", h); sub(/:[[:space:]]*$/, "", h); cur=h; next }
    inhosts && /^        user:/ { v=$0; sub(/^        user:[[:space:]]*/, "", v); printf "%s\t%s\n", cur, v }
  ' "$cfg" 2>/dev/null)
  (( found )) || row gitlab GitLab "glab CLI" "" "" signed-out "" ""
}

goa_accounts() { # <provider-regex> → "identity<TAB>provider" lines
  local f="$CFG/goa-1.0/accounts.conf"
  [[ -f $f ]] || return 0
  awk -v want="$1" '
    function flush() { if (prov ~ want && ident != "") printf "%s\t%s\n", ident, prov; prov=""; ident=""; pres="" }
    /^\[Account / { flush(); next }
    /^Provider=/ { prov=substr($0, 10) }
    /^PresentationIdentity=/ { ident=substr($0, 22) }
    /^Identity=/ { if (ident == "") ident=substr($0, 10) }
    END { flush() }
  ' "$f" 2>/dev/null
}

provider_google() {
  # `client` notes that some Google client is configured; `signed` that at least
  # one identity was found. Only the first without the second yields a row
  # saying nothing is signed in — otherwise a second, unsigned browser would
  # add a contradictory "signed out" row next to the signed-in one.
  local client=0 signed=0 browser label state user name
  for browser in chromium google-chrome google-chrome-beta google-chrome-unstable vivaldi; do
    state="$CFG/$browser/Local State"
    [[ -f $state ]] || continue
    client=1
    case $browser in
      chromium) label=Chromium ;; vivaldi) label=Vivaldi ;; *) label="Google Chrome" ;;
    esac
    while IFS=$'\t' read -r user name; do
      [[ -n $user ]] || continue
      row google Google "$label · $name" "$user" "" connected "" ""
      signed=1
    done < <(browser_profiles "$state")
  done

  local gc=${CLOUDSDK_CONFIG:-$CFG/gcloud}
  if [[ -d $gc ]]; then
    client=1
    local active=default acct
    [[ -f $gc/active_config ]] && active=$(head -n1 "$gc/active_config" 2>/dev/null)
    acct=$(ini_value "$gc/configurations/config_${active:-default}" core account)
    acct=$(unquote "$acct")
    if [[ -n $acct ]]; then
      row google Google "gcloud" "$acct" "" connected "" "Configuration: ${active:-default}"
      signed=1
    fi
  fi

  local ident
  while IFS=$'\t' read -r ident _; do
    row google Google "GNOME Online Accounts" "$ident" "" connected "" ""
    signed=1
  done < <(goa_accounts '^google$')

  if (( client && ! signed )); then
    row google Google "Browser" "" "" signed-out "" "No signed-in browser profile"
  fi
}

provider_gemini() {
  local dir="$HOME/.gemini"
  [[ -d $dir ]] || return 0
  local active=""
  [[ -f $dir/google_accounts.json ]] && active=$(jq -r '.active // empty | strings' "$dir/google_accounts.json" 2>/dev/null)
  if [[ -n $active ]]; then
    row gemini Gemini "Gemini CLI" "$active" "" connected "" ""
  elif [[ -f $dir/oauth_creds.json ]]; then
    row gemini Gemini "Gemini CLI" "Google account" "" connected "" ""
  else
    row gemini Gemini "Gemini CLI" "" "" signed-out "" ""
  fi
}

provider_microsoft() {
  local browser state user name
  for browser in microsoft-edge microsoft-edge-beta microsoft-edge-dev; do
    state="$CFG/$browser/Local State"
    [[ -f $state ]] || continue
    while IFS=$'\t' read -r user name; do
      [[ -n $user ]] && row microsoft Microsoft "Edge · $name" "$user" "" connected "" ""
    done < <(browser_profiles "$state")
  done
  local ident
  while IFS=$'\t' read -r ident _; do
    row microsoft Microsoft "GNOME Online Accounts" "$ident" "" connected "" ""
  done < <(goa_accounts '^(ms365|windows_live|exchange)$')
}

claude_plan() { # <subscriptionType> <rateLimitTier> <organizationType>
  local sub=${1,,} tier=${2,,} org=${3,,}
  [[ -n $sub ]] || sub=${org#claude_}
  case $sub in
    max)
      if [[ $tier == *20x* ]]; then echo "Max 20x"
      elif [[ $tier == *5x* ]]; then echo "Max 5x"
      else echo "Max"; fi ;;
    pro) echo "Pro" ;;
    team) echo "Team" ;;
    enterprise) echo "Enterprise" ;;
    "") echo "" ;;
    *) echo "${sub^}" ;;
  esac
}

provider_claude() {
  local cj cred
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
    cj="$CLAUDE_CONFIG_DIR/.claude.json"; cred="$CLAUDE_CONFIG_DIR/.credentials.json"
  else
    cj="$HOME/.claude.json"; cred="$HOME/.claude/.credentials.json"
  fi
  [[ -f $cj || -f $cred ]] || return 0

  local email="" org="" orgtype="" apikey="null"
  if [[ -f $cj ]]; then
    IFS=$'\t' read -r email org orgtype apikey < <(jq -r '[
        (.oauthAccount.emailAddress // "" | strings),
        (.oauthAccount.organizationName // "" | strings),
        (.oauthAccount.organizationType // "" | strings),
        (.primaryApiKey | type)] | @tsv' "$cj" 2>/dev/null)
  fi

  local sub="" tier="" rexp="" rtype="null" atype="null" aexp=""
  if [[ -f $cred ]]; then
    IFS=$'\t' read -r sub tier rexp rtype atype aexp < <(jq -r '[
        (.claudeAiOauth.subscriptionType // "" | strings),
        (.claudeAiOauth.rateLimitTier // "" | strings),
        (.claudeAiOauth.refreshTokenExpiresAt // "" | tostring),
        (.claudeAiOauth.refreshToken | type),
        (.claudeAiOauth.accessToken | type),
        (.claudeAiOauth.expiresAt // "" | tostring)] | @tsv' "$cred" 2>/dev/null)
  fi

  local plan note="" status exp=""
  plan=$(claude_plan "$sub" "$tier" "$orgtype")
  [[ -n $org ]] && note="Org: $org"

  if [[ $rtype == string ]]; then
    exp=$rexp; status=$(expiry_status "$exp")
  elif [[ $atype == string ]]; then
    exp=$aexp; status=$(expiry_status "$exp")
  elif [[ -n $email ]]; then
    status=connected; note="${note:+$note · }No credentials file on disk"
  elif [[ $apikey == string ]]; then
    row claude Claude "Claude Code" "API key" "API" connected "" ""; return 0
  else
    row claude Claude "Claude Code" "" "" signed-out "" ""; return 0
  fi
  [[ -n $email ]] || email="Claude account"
  row claude Claude "Claude Code" "$email" "$plan" "$status" "$exp" "$note"
}

codex_claims() { # <auth.json> → email<TAB>plan<TAB>active_until (allowlisted claims only)
  python3 -I - "$1" <<'PY' 2>/dev/null
import base64, json, sys
try:
    with open(sys.argv[1]) as fh:
        token = (json.load(fh).get("tokens") or {}).get("id_token") or ""
    seg = token.split(".")[1]
    seg += "=" * (-len(seg) % 4)
    claims = json.loads(base64.urlsafe_b64decode(seg))
    auth = claims.get("https://api.openai.com/auth") or {}
    out = [claims.get("email") or "", auth.get("chatgpt_plan_type") or "",
           auth.get("chatgpt_subscription_active_until") or ""]
    print("\t".join(str(v).replace("\t", " ").replace("\n", " ") for v in out))
except Exception:
    print("\t\t")
PY
}

provider_openai() {
  local dir=${CODEX_HOME:-$HOME/.codex}
  [[ -d $dir ]] || return 0
  local auth="$dir/auth.json"
  if [[ -f $auth ]]; then
    local mode rtype itype ktype
    IFS=$'\t' read -r mode rtype itype ktype < <(jq -r '[
        (.auth_mode // "" | strings),
        (.tokens.refresh_token | type),
        (.tokens.id_token | type),
        (.OPENAI_API_KEY | type)] | @tsv' "$auth" 2>/dev/null)
    if [[ $rtype == string || $itype == string ]]; then
      local email="" plan_type="" until="" plan note=""
      IFS=$'\t' read -r email plan_type until < <(codex_claims "$auth")
      case ${plan_type,,} in
        "") plan="ChatGPT" ;;
        pro|plus|team|free|enterprise|business|edu) plan="ChatGPT ${plan_type^}" ;;
        *) plan="ChatGPT ${plan_type}" ;;
      esac
      if [[ -n $until ]]; then
        local until_ms
        until_ms=$(iso_to_ms "$until")
        if [[ -n $until_ms ]] && (( until_ms > NOW_MS )); then
          note="Renews $(date -d "@$(( until_ms / 1000 ))" '+%b %-d' 2>/dev/null)"
        fi
      fi
      row openai OpenAI "Codex CLI" "${email:-ChatGPT account}" "$plan" connected "" "$note"
      return 0
    fi
    if [[ $ktype == string || ${mode,,} == apikey ]]; then
      row openai OpenAI "Codex CLI" "API key" "API" connected "" ""
      return 0
    fi
  fi
  if [[ -f $dir/config.toml ]] && grep -qE '^[[:space:]]*cli_auth_credentials_store[[:space:]]*=[[:space:]]*"keyring"' "$dir/config.toml" 2>/dev/null; then
    row openai OpenAI "Codex CLI" "Stored in keyring" "" connected "" ""
    return 0
  fi
  row openai OpenAI "Codex CLI" "" "" signed-out "" ""
}

provider_tailscale() {
  have tailscale || return 0
  local out
  out=$(timeout 2 tailscale status --json 2>/dev/null) || out=""
  [[ -n $out ]] || { row tailscale Tailscale "tailscale" "" "" signed-out "" "Daemon not running"; return 0; }
  local state login tailnet
  IFS=$'\t' read -r state login tailnet < <(jq -r '[
      (.BackendState // ""),
      (.User[((.Self.UserID // 0) | tostring)].LoginName // ""),
      (.CurrentTailnet.Name // "")] | @tsv' <<<"$out" 2>/dev/null)
  case $state in
    Running) row tailscale Tailscale "tailscale" "$login" "" connected "" "${tailnet:+Tailnet: $tailnet}" ;;
    Stopped) row tailscale Tailscale "tailscale" "$login" "" connected "" "Stopped" ;;
    *) row tailscale Tailscale "tailscale" "" "" signed-out "" "" ;;
  esac
}

provider_docker() {
  local cfg="${DOCKER_CONFIG:-$HOME/.docker}/config.json"
  [[ -f $cfg ]] || return 0
  local registries
  registries=$(jq -r '[(.auths // {} | keys[]), (.credHelpers // {} | keys[])]
      | map(if test("index\\.docker\\.io|docker\\.com") then "Docker Hub" else sub("^https?://"; "") | sub("/.*$"; "") end)
      | unique | join(", ")' "$cfg" 2>/dev/null)
  if [[ -n $registries ]]; then
    row docker Docker "docker config" "$registries" "" connected "" ""
  else
    row docker Docker "docker config" "" "" signed-out "" ""
  fi
}

provider_aws() {
  local cfg=${AWS_CONFIG_FILE:-$HOME/.aws/config}
  local creds=${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}
  [[ -f $cfg || -f $creds ]] || return 0
  local profiles
  profiles=$( { grep -hoE '^\[(profile )?[^]]+\]' "$cfg" "$creds" 2>/dev/null || true; } \
              | sed -E 's/^\[(profile )?//; s/\]$//' | grep -v '^sso-session ' | sort -u | paste -sd, - | sed 's/,/, /g')
  [[ -n $profiles ]] || { row aws AWS "aws config" "" "" signed-out "" ""; return 0; }
  local count
  count=$(tr ',' '\n' <<<"$profiles" | grep -c .)
  local status=connected exp="" note=""
  local cache="$HOME/.aws/sso/cache"
  if [[ -d $cache ]]; then
    local newest="" f e ms
    for f in "$cache"/*.json; do
      [[ -f $f ]] || continue
      e=$(jq -r '.expiresAt // empty | strings' "$f" 2>/dev/null)
      ms=$(iso_to_ms "$e")
      [[ -n $ms ]] || continue
      if [[ -z $newest ]] || (( ms > newest )); then newest=$ms; fi
    done
    if [[ -n $newest ]]; then
      exp=$newest
      if (( newest <= NOW_MS )); then status=expired; note="SSO session expired"
      else note="SSO session until $(date -d "@$(( newest / 1000 ))" '+%H:%M' 2>/dev/null)"
      fi
    fi
  fi
  local label="$count profile"; (( count == 1 )) || label+="s"
  row aws AWS "aws config" "$label: $profiles" "" "$status" "$exp" "$note"
}

provider_huggingface() {
  local dir=${HF_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/huggingface}
  [[ -d $dir ]] || return 0
  local names=""
  [[ -f $dir/stored_tokens ]] && names=$(grep -oE '^\[[^]]+\]' "$dir/stored_tokens" 2>/dev/null | tr -d '[]' | paste -sd, - | sed 's/,/, /g')
  if [[ -f $dir/token ]]; then
    row huggingface "Hugging Face" "huggingface_hub" "${names:+token: $names}" "" connected "" ""
  elif [[ -n $names ]]; then
    row huggingface "Hugging Face" "huggingface_hub" "" "" signed-out "" "Stored tokens: $names"
  fi
}

# ---------------------------------------------------------------- AI coding tools

# sqlite_rows <db> <sql>: TSV rows over a read-only connection. Callers pass
# fixed queries that select identity columns only. Not `immutable=1`: these
# databases are live while their apps run, and immutable reads can be corrupt.
sqlite_rows() {
  python3 -I - "$1" "$2" <<'PY' 2>/dev/null
import sqlite3, sys, urllib.parse
db, sql = sys.argv[1], sys.argv[2]
try:
    con = sqlite3.connect("file:" + urllib.parse.quote(db) + "?mode=ro", uri=True, timeout=1)
    for row in con.execute(sql):
        out = []
        for v in row:
            if isinstance(v, bytes):
                v = v.decode("utf-8", "replace")
            out.append("" if v is None else str(v).replace("\t", " ").replace("\n", " "))
        print("\t".join(out))
except Exception:
    pass
PY
}

provider_copilot() {
  local dir found=0 host user active
  dir="$CFG/github-copilot"
  # Editor plugins (copilot.vim / copilot.lua). Language server ≥1.488 keeps
  # auth.db; older ones apps.json / hosts.json, which go stale after migration.
  if [[ -f $dir/auth.db ]]; then
    while IFS=$'\t' read -r host user active; do
      [[ -n $user ]] || continue
      found=1
      host=${host#https://}; host=${host%%/*}
      if [[ $active == 1 ]]; then
        row copilot "GitHub Copilot" "Copilot editor plugin · ${host:-github.com}" "$user" "" connected "" ""
      else
        row copilot "GitHub Copilot" "Copilot editor plugin · ${host:-github.com}" "$user" "" signed-out "" ""
      fi
    done < <(sqlite_rows "$dir/auth.db" "
      SELECT t.auth_authority, t.user_login,
             MAX(EXISTS (SELECT 1 FROM active_sessions s WHERE s.token_id = t.token_id))
      FROM oauth_tokens t GROUP BY t.auth_authority, t.user_login")
  else
    local f
    for f in "$dir/apps.json" "$dir/hosts.json"; do
      [[ -f $f ]] || continue
      while IFS=$'\t' read -r host user; do
        [[ -n $user ]] || continue
        found=1
        row copilot "GitHub Copilot" "Copilot editor plugin · ${host%:*}" "$user" "" connected "" ""
      done < <(jq -r 'to_entries[] | [.key, (.value.user // .value.login // "" | strings)] | @tsv' "$f" 2>/dev/null)
      (( found )) && break
    done
  fi

  # Standalone Copilot CLI: JSON behind `//` comment lines; tokens are in the
  # keyring or a copilotTokens map that is never read.
  local cfg
  cfg=$(first_file "${COPILOT_HOME:-$HOME/.copilot}/config.json" "$CFG/.copilot/config.json")
  if [[ -n $cfg ]]; then
    while IFS=$'\t' read -r host user; do
      [[ -n $user ]] || continue
      found=1
      host=${host#https://}; host=${host%%/*}
      row copilot "GitHub Copilot" "Copilot CLI · ${host:-github.com}" "$user" "" connected "" ""
    done < <(grep -v '^[[:space:]]*//' "$cfg" 2>/dev/null | jq -r '
        [(.loggedInUsers // .logged_in_users // [])[], (.lastLoggedInUser // .last_logged_in_user // empty)]
        | map(objects | [(.host // ""), (.login // "")]) | unique[] | @tsv' 2>/dev/null)
  fi
  if (( ! found )) && [[ -d $dir || -n $cfg ]]; then
    row copilot "GitHub Copilot" "Copilot" "" "" signed-out "" ""
  fi
}

provider_cursor() {
  local db
  db=$(first_file "$CFG/Cursor/User/globalStorage/state.vscdb" "$CFG/cursor/User/globalStorage/state.vscdb") || return 0
  local email="" plan="" token=0 key value
  while IFS=$'\t' read -r key value; do
    value=${value#\"}; value=${value%\"}
    case $key in
      cursorAuth/cachedEmail) email=$value ;;
      cursorAuth/stripeMembershipType) plan=$value ;;
      has_token) token=$value ;;
    esac
  done < <(sqlite_rows "$db" "
    SELECT key, value FROM ItemTable
      WHERE key IN ('cursorAuth/cachedEmail', 'cursorAuth/stripeMembershipType')
    UNION ALL
    SELECT 'has_token', count(*) FROM ItemTable
      WHERE key = 'cursorAuth/accessToken' AND length(value) > 2")
  case ${plan,,} in
    ""|free) plan="" ;;
    pro|business|enterprise|team|ultra) plan=${plan^} ;;
  esac
  if [[ -n $email && $token -gt 0 ]]; then
    row cursor Cursor "Cursor" "$email" "$plan" connected "" ""
  else
    row cursor Cursor "Cursor" "" "" signed-out "" ""
  fi
}

provider_opencode() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
  [[ -d $dir ]] || return 0
  local found=0
  # auth.json: provider id → {type, …secrets}. Only ids and types are read.
  if [[ -f $dir/auth.json ]]; then
    local providers
    providers=$(jq -r 'to_entries | map(select(.value | type == "object") | .key | sub("/+$"; ""))
                       | sort | join(", ")' "$dir/auth.json" 2>/dev/null)
    if [[ -n $providers ]]; then
      found=1
      row opencode opencode "opencode" "$providers" "" connected "" "Signed-in model providers"
    fi
  fi
  # opencode console account (opencode.db): the active account's email only.
  if [[ -f $dir/opencode.db ]]; then
    local email url
    while IFS=$'\t' read -r email url; do
      [[ -n $email ]] || continue
      found=1
      row opencode opencode "opencode console" "$email" "" connected "" "${url#https://}"
    done < <(sqlite_rows "$dir/opencode.db" "
      SELECT a.email, a.url FROM account a JOIN account_state s ON s.active_account_id = a.id")
  fi
  (( found )) || row opencode opencode "opencode" "" "" signed-out "" ""
}

# ---------------------------------------------------------------- password managers

provider_1password() {
  # op CLI config. With desktop-app integration `accounts` is null and the file
  # holds no email, so nothing is claimed. accountKey / dsecret / device are
  # secrets and never read.
  local f="" d
  for d in ${OP_CONFIG_DIR:+"$OP_CONFIG_DIR"} "$HOME/.op" "$CFG/.op" "$CFG/op"; do
    if [[ -f $d/config ]]; then f="$d/config"; break; fi
  done
  [[ -n $f ]] || return 0
  local email url
  while IFS=$'\t' read -r email url; do
    [[ -n $email ]] || continue
    row 1password 1Password "1Password CLI" "$email" "" connected "" "${url#https://}"
  done < <(jq -r '(.accounts // [])[] | [(.email // "" | strings), (.url // "" | strings)] | @tsv' "$f" 2>/dev/null)
}

provider_bitwarden() {
  # data.json holds plaintext tokens and the vault: read only the account map
  # and test the access token's existence as a boolean.
  local f
  f=$(first_file ${BITWARDENCLI_APPDATA_DIR:+"$BITWARDENCLI_APPDATA_DIR/data.json"} \
        "$CFG/Bitwarden CLI/data.json" "$HOME/snap/bw/current/.config/Bitwarden CLI/data.json") || return 0
  local email token
  IFS=$'\t' read -r email token < <(jq -r '
      if has("global_account_activeAccountId") then
        .global_account_activeAccountId as $id
        | if ($id | type) != "string" then ["", "false"]
          else [(.global_account_accounts[$id].email // "" | strings),
                (.["user_\($id)_token_accessToken"] != null | tostring)] end
      else
        .activeUserId as $id
        | if ($id | type) != "string" then ["", "false"]
          else [(.[$id].profile.email // "" | strings),
                ((.[$id].tokens.accessToken | type) == "string" | tostring)] end
      end | @tsv' "$f" 2>/dev/null)
  if [[ -n $email && $token == true ]]; then
    row bitwarden Bitwarden "Bitwarden CLI" "$email" "" connected "" ""
  else
    row bitwarden Bitwarden "Bitwarden CLI" "" "" signed-out "" ""
  fi
}

# ---------------------------------------------------------------- cloud & deploy CLIs
# Several of these keep no identity on disk (Vercel, Fly, Supabase, Terraform,
# wrangler OAuth); their rows say a credential exists, nothing more. Keyrings
# are never queried: `secret-tool search` prints the secret.

provider_azure() {
  local f="${AZURE_CONFIG_DIR:-$HOME/.azure}/azureProfile.json"
  [[ -f $f ]] || return 0
  local found=0 user subs default
  # The CLI writes this file as utf-8-sig, so strip the BOM before jq.
  while IFS=$'\t' read -r user subs default; do
    [[ -n $user ]] || continue
    found=1
    local note="$subs subscription"; (( subs == 1 )) || note+="s"
    [[ -n $default ]] && note="Default: $default · $note"
    row azure Azure "Azure CLI" "$user" "" connected "" "$note"
  done < <(sed '1s/^\xEF\xBB\xBF//' "$f" 2>/dev/null | jq -r '
      (.subscriptions // []) | group_by(.user.name)[]
      | [.[0].user.name // "", length, ((map(select(.isDefault)) | .[0].name) // "")] | @tsv' 2>/dev/null)
  (( found )) || row azure Azure "Azure CLI" "" "" signed-out "" ""
}

provider_vercel() {
  local data=${XDG_DATA_HOME:-$HOME/.local/share} dir=""
  for dir in "$data/com.vercel.cli" "$HOME/.now" "$data/now"; do
    [[ -d $dir ]] && break
    dir=""
  done
  [[ -n $dir && -f $dir/auth.json ]] || return 0
  local tok
  tok=$(jq -r '[(.token | type), (.refreshToken | type)] | any(. == "string")' "$dir/auth.json" 2>/dev/null)
  if [[ $tok == true ]]; then
    row vercel Vercel "Vercel CLI" "" "" connected "" "No account name is stored locally"
  else
    row vercel Vercel "Vercel CLI" "" "" signed-out "" ""
  fi
}

provider_netlify() {
  local f
  f=$(first_file "$CFG/netlify/config.json" "$HOME/.netlify/config.json") || return 0
  # Logout only clears userId; the users map (and its token) stays behind.
  local email name
  IFS=$'\t' read -r email name < <(jq -r '
      .userId as $u | if ($u | type) != "string" then empty
      else [(.users[$u].email // "" | strings), (.users[$u].name // "" | strings)] | @tsv end' "$f" 2>/dev/null)
  if [[ -n $email || -n $name ]]; then
    row netlify Netlify "Netlify CLI" "${email:-$name}" "" connected "" "${email:+$name}"
  else
    row netlify Netlify "Netlify CLI" "" "" signed-out "" ""
  fi
}

provider_cloudflare() {
  local dir="$CFG/.wrangler"
  [[ -d $HOME/.wrangler ]] && dir="$HOME/.wrangler"
  [[ -d $dir ]] || return 0
  local toml="$dir/config/default.toml"
  if [[ -f $dir/config/default.enc ]]; then
    row cloudflare Cloudflare "wrangler" "" "" connected "" "Encrypted credentials (keyring)"
  elif [[ -f $toml ]]; then
    # Key presence only; the token values are never captured.
    if grep -qE '^[[:space:]]*refresh_token[[:space:]]*=' "$toml" 2>/dev/null; then
      row cloudflare Cloudflare "wrangler" "" "" connected "" "OAuth session"
    elif grep -qE '^[[:space:]]*oauth_token[[:space:]]*=' "$toml" 2>/dev/null; then
      local exp ms
      exp=$(sed -nE 's/^[[:space:]]*expiration_time[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$toml" | head -n1)
      ms=$(iso_to_ms "$exp")
      row cloudflare Cloudflare "wrangler" "" "" "$(expiry_status "$ms")" "$ms" "OAuth session"
    elif grep -qE '^[[:space:]]*api_token[[:space:]]*=' "$toml" 2>/dev/null; then
      row cloudflare Cloudflare "wrangler" "" "" connected "" "API token"
    else
      row cloudflare Cloudflare "wrangler" "" "" signed-out "" ""
    fi
  else
    row cloudflare Cloudflare "wrangler" "" "" signed-out "" ""
  fi
}

provider_fly() {
  local f="${FLY_CONFIG_DIR:-$HOME/.fly}/config.yml"
  [[ -f $f ]] || return 0
  # Signed in = a non-empty access_token value (tested, never captured).
  if grep -qE "^access_token:[[:space:]]*[\"']?[^\"'[:space:]]" "$f" 2>/dev/null; then
    local last note=""
    last=$(sed -nE "s/^last_login:[[:space:]]*[\"']?([^\"']*)[\"']?[[:space:]]*$/\1/p" "$f" | head -n1)
    local ms; ms=$(iso_to_ms "$last")
    if [[ -n $ms ]] && (( ms > 0 )); then note="Last login $(date -d "@$(( ms / 1000 ))" '+%b %-d, %Y' 2>/dev/null)"; fi
    row fly Fly.io "flyctl" "" "" connected "" "$note"
  else
    row fly Fly.io "flyctl" "" "" signed-out "" ""
  fi
}

provider_heroku() {
  local data=${HEROKU_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/heroku} email=""
  # Current CLIs keep the token in the keyring and the email in login.json.
  [[ -f $data/login.json ]] && email=$(jq -r '.account // empty | strings' "$data/login.json" 2>/dev/null)
  if [[ -z $email && -f $HOME/.netrc ]]; then
    # Older CLIs: netrc. Walk the tokens and keep only the api.heroku.com login.
    email=$(awk '
      { for (i = 1; i <= NF; i++) {
          if ($i == "machine") { host = $(i + 1); i++ }
          else if ($i == "login" && host == "api.heroku.com") { print $(i + 1); exit }
      } }' "$HOME/.netrc" 2>/dev/null)
  fi
  if [[ -n $email ]]; then
    row heroku Heroku "Heroku CLI" "$email" "" connected "" ""
  elif [[ -d $data ]]; then
    row heroku Heroku "Heroku CLI" "" "" signed-out "" ""
  fi
}

provider_firebase() {
  local f="$CFG/configstore/firebase-tools.json"
  [[ -f $f ]] || return 0
  local found=0 email
  while IFS= read -r email; do
    [[ -n $email ]] || continue
    found=1
    row firebase Firebase "Firebase CLI" "$email" "" connected "" ""
  done < <(jq -r '
      (if (.tokens.refresh_token | type) == "string" then [.user.email] else [] end)
      + [(.additionalAccounts // [])[] | select((.tokens.refresh_token | type) == "string") | .user.email]
      | map(strings) | unique[]' "$f" 2>/dev/null)
  (( found )) || row firebase Firebase "Firebase CLI" "" "" signed-out "" ""
}

provider_supabase() {
  # Newer CLIs keep the token in the keyring, which isn't queried, so only the
  # file fallback is reported (and no signed-out row is guessed).
  [[ -f ${SUPABASE_HOME:-$HOME/.supabase}/access-token ]] || return 0
  row supabase Supabase "Supabase CLI" "" "" connected "" "Access token file"
}

provider_npm() {
  local f=${npm_config_userconfig:-${NPM_CONFIG_USERCONFIG:-$HOME/.npmrc}}
  [[ -f $f ]] || return 0
  # Registry-scoped auth lines: report the host, never the value. A value of
  # ${VAR} means the token comes from the environment.
  local hosts
  hosts=$(sed -nE 's#^[[:space:]]*//([^/:]+)[^:]*:(_authToken|_auth|_password)[[:space:]]*=.*#\1#p' "$f" 2>/dev/null \
          | sed 's/^registry\.//' | sort -u | paste -sd, - | sed 's/,/, /g')
  [[ -n $hosts ]] || return 0
  local user
  user=$(sed -nE 's#^[[:space:]]*//registry\.npmjs\.org/:username[[:space:]]*=[[:space:]]*(.*)$#\1#p' "$f" 2>/dev/null | head -n1)
  local note=""
  grep -qE ':_authToken[[:space:]]*=[[:space:]]*\$\{' "$f" 2>/dev/null && note="Token from environment"
  row npm npm ".npmrc" "${user:-$hosts}" "" connected "" "$note"
}

provider_terraform() {
  local f="$HOME/.terraform.d/credentials.tfrc.json"
  [[ -f $f ]] || return 0
  local hosts
  hosts=$(jq -r '.credentials // {} | keys | join(", ")' "$f" 2>/dev/null)
  if [[ -n $hosts ]]; then
    row terraform Terraform "terraform login" "$hosts" "" connected "" ""
  else
    row terraform Terraform "terraform login" "" "" signed-out "" ""
  fi
}

