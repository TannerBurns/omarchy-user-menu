  f=$(first_file "$CFG/Slack/storage/root-state.json" \
        "$HOME/.var/app/com.slack.Slack/config/Slack/storage/root-state.json" \
        "$HOME/snap/slack/current/.config/Slack/storage/root-state.json") || return 0
