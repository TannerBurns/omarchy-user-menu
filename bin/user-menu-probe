    local label="$n workspace"; (( n == 1 )) || label+="s"
    row slack Slack "Slack desktop" "$label" "" connected "" ""
  else
    row slack Slack "Slack desktop" "" "" signed-out "" ""
  fi
}

provider_spotify() {
  # Only the two username lines are read; autologin.blob and
  # autologin.saved_credentials are reusable credentials.
  local f user
  f=$(first_file "$CFG/spotify/prefs" \
        "$HOME/.var/app/com.spotify.Client/config/spotify/prefs" \
        "$HOME/snap/spotify/current/.config/spotify/prefs") || return 0
  user=$(sed -nE 's/^autologin\.username="?([^"]*)"?[[:space:]]*$/\1/p' "$f" 2>/dev/null | head -n1)
  [[ -n $user ]] || user=$(sed -nE 's/^autologin\.canonical_username="?([^"]*)"?[[:space:]]*$/\1/p' "$f" 2>/dev/null | head -n1)
  if [[ -n $user ]]; then
    row spotify Spotify "Spotify" "$user" "" connected "" ""
  else
    row spotify Spotify "Spotify" "" "" signed-out "" ""
  fi
}

provider_steam() {
  local dir vdf=""
  for dir in "$HOME/.local/share/Steam" "$HOME/.steam/steam" "$HOME/.steam/debian-installation" \
             "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
             "$HOME/.var/app/com.valvesoftware.Steam/data/Steam" \
             "$HOME/snap/steam/common/.local/share/Steam"; do
    if [[ -f $dir/config/loginusers.vdf ]]; then vdf="$dir/config/loginusers.vdf"; break; fi
  done
  [[ -n $vdf ]] || return 0
  # VDF: "users" { "<steamid64>" { "AccountName" "…" "PersonaName" "…" "MostRecent" "1" "Timestamp" "…" } }
  # Current account = MostRecent 1, else the newest Timestamp (newer clients omit MostRecent).
  local account persona
  IFS=$'\t' read -r account persona < <(awk '
    { n = split($0, p, "\"") }
    n == 3 && p[2] ~ /^[0-9]+$/ { id = p[2]; acct = ""; pers = ""; recent = 0; ts = 0; next }
    n >= 5 && id != "" {
      key = tolower(p[2]); val = p[4]
      if (key == "accountname") acct = val
      else if (key == "personaname") pers = val
      else if (key == "mostrecent") recent = (val == "1")
      else if (key == "timestamp") ts = val + 0
      next
    }
    /^[[:space:]]*}/ && id != "" {
      score = recent * 1e12 + ts
      if (best == "" || score > bestscore) { best = acct; bestp = pers; bestscore = score }
      id = ""
    }
    END { if (best != "") printf "%s\t%s\n", best, bestp }
  ' "$vdf" 2>/dev/null)
  if [[ -n $account ]]; then
    local identity=$account
    [[ -n $persona && $persona != "$account" ]] && identity="$persona ($account)"
    row steam Steam "Steam" "$identity" "" connected "" ""
  else
    row steam Steam "Steam" "" "" signed-out "" ""
  fi
}

provider_dropbox() {
  # info.json is written when an account is linked. It holds no email; the
  # encrypted instance*/config.dbx is never touched.
  local dir="$HOME/.dropbox"
  [[ -d $dir ]] || return 0
  local found=0 kind sub
  if [[ -f $dir/info.json ]]; then
    while IFS=$'\t' read -r kind sub; do
      [[ -n $kind ]] || continue
      found=1
      row dropbox Dropbox "Dropbox" "${kind^} account" "$sub" connected "" ""
    done < <(jq -r 'to_entries[] | select(.key == "personal" or .key == "business")
                    | [.key, (.value.subscription_type // "" | strings)] | @tsv' "$dir/info.json" 2>/dev/null)
  fi
  (( found )) || row dropbox Dropbox "Dropbox" "" "" signed-out "" ""
}

provider_nextcloud() {
  # Qt INI: [Accounts] with numbered groups (0\url, 0\dav_user, …). Passwords
  # live in the keyring; certificate blobs in the file are skipped.
  local f
  f=$(first_file "$CFG/Nextcloud/nextcloud.cfg" \
        "$HOME/.var/app/com.nextcloud.desktopclient.nextcloud/config/Nextcloud/nextcloud.cfg") || return 0
  local found=0 user url host
  while IFS=$'\t' read -r user url; do
    [[ -n $user || -n $url ]] || continue
    found=1
    host=${url#*://}; host=${host%%/*}
    row nextcloud Nextcloud "Nextcloud desktop" "${user:-account}${host:+@$host}" "" connected "" ""
  done < <(awk '
    /^\[/ { inacc = ($0 == "[Accounts]"); next }
    inacc && match($0, /^[0-9]+\\(dav_user|url)=/) {
      eq = index($0, "="); key = substr($0, 1, eq - 1); val = substr($0, eq + 1)
      bs = index(key, "\\"); idx = substr(key, 1, bs - 1); name = substr(key, bs + 1)
      gsub(/^"|"$/, "", val)
      if (name == "dav_user") user[idx] = val; else url[idx] = val
      seen[idx] = 1
    }
    END { for (i in seen) printf "%s\t%s\n", user[i], url[i] }
  ' "$f" 2>/dev/null | sort)
  (( found )) || row nextcloud Nextcloud "Nextcloud desktop" "" "" signed-out "" ""
}

# ---------------------------------------------------------------- security

security_ssh() {
  local dir="$HOME/.ssh" keys="[]"
  if [[ -d $dir ]] && have ssh-keygen; then
    local f line
    keys=$(for f in "$dir"/*.pub; do
      [[ -f $f ]] || continue
      line=$(ssh-keygen -lf "$f" 2>/dev/null) || continue
      jq -nc --arg file "${f##*/}" --arg line "$line" '
        ($line | capture("^(?<bits>[0-9]+) (?<fp>\\S+) ?(?<comment>.*) \\((?<type>[^)]+)\\)$")) as $m
        | {file: $file, type: $m.type, bits: ($m.bits | tonumber), fingerprint: $m.fp, comment: $m.comment}'
    done | jq -sc '.')
  fi
  jq -nc --argjson keys "${keys:-[]}" --arg exists "$([[ -d $dir ]] && echo 1)" \
    '{ssh: {dirExists: ($exists == "1"), keys: $keys}}'
}

security_gpg() {
  local home=${GNUPGHOME:-$HOME/.gnupg}
  # gpg creates its home directory on first run; never let the probe do that.
  if [[ ! -d $home ]] || ! have gpg; then
    jq -nc --arg exists "$([[ -d $home ]] && echo 1)" '{gpg: {homeExists: ($exists == "1"), checked: false, keys: []}}'
    return
  fi
  local keys
  keys=$(timeout 5 gpg --batch --no-tty --with-colons --fingerprint --list-secret-keys 2>/dev/null | awk -F: '
    function flush() { if (fpr != "") printf "%s\t%s\t%s\t%s\t%s\n", fpr, uid, algo, exp, val; fpr=""; uid=""; algo=""; exp=""; val=""; want=0 }
    $1 == "sec" { flush(); val=$2; exp=$7; algo=($17 != "" ? $17 : $4); want=1; next }
    $1 == "fpr" && want == 1 { fpr=$10; want=2; next }
    $1 == "uid" && uid == "" { uid=$10; next }
    END { flush() }' | while IFS=$'\t' read -r fpr uid algo exp val; do
      jq -nc --arg fpr "$fpr" --arg uid "$uid" --arg algo "$algo" --arg exp "$exp" --arg val "$val" '
        {fingerprint: $fpr, uid: ($uid | gsub("\\\\x3a"; ":")),
         algo: ({"1": "rsa", "17": "dsa", "18": "ecdh", "19": "ecdsa", "22": "eddsa"}[$algo] // $algo),
         expiresEpochMs: ($exp | if test("^[0-9]+$") then (tonumber * 1000) else null end), validity: $val}'
    done | jq -sc '.')
  jq -nc --argjson keys "${keys:-[]}" '{gpg: {homeExists: true, checked: true, keys: $keys}}'
}

security_keyring() {
  local out service=false collection=false locked=null label=""
  if out=$(busctl --user --auto-start=no --json=short get-property org.freedesktop.secrets \
             /org/freedesktop/secrets/aliases/default org.freedesktop.Secret.Collection Locked Label 2>/dev/null); then
    service=true; collection=true
    # Not `// null`: jq's alternative operator treats `false` as missing.
    locked=$(jq -rs '.[0].data | if type == "boolean" then . else null end' <<<"$out" 2>/dev/null)
    label=$(jq -rs '.[1].data // ""' <<<"$out" 2>/dev/null)
  elif busctl --user list --acquired --json=short 2>/dev/null | jq -e 'any(.[]; .name == "org.freedesktop.secrets")' >/dev/null 2>&1; then
    service=true
  fi
  jq -nc --argjson service "$service" --argjson collection "$collection" --argjson locked "${locked:-null}" --arg label "$label" \
    '{keyring: {service: $service, collection: $collection, locked: $locked, label: $label}}'
}

security_fingerprint() {
  local reader=null fprintd=false enrolled=null
  if have omarchy-hw-fingerprint; then
    if timeout 3 omarchy-hw-fingerprint >/dev/null 2>&1; then reader=true; else reader=false; fi
  fi
  if have fprintd-list; then
    fprintd=true
    if [[ $reader != false ]]; then
      local out
      if out=$(timeout 4 fprintd-list "$USERNAME" 2>/dev/null); then
        enrolled=$(grep -cE '^ - #[0-9]+:' <<<"$out" || true)
        [[ $reader == null ]] && reader=true
      fi
    fi
  fi
  jq -nc --argjson reader "$reader" --argjson fprintd "$fprintd" --argjson enrolled "${enrolled:-null}" \
    '{fingerprint: {reader: $reader, fprintd: $fprintd, enrolled: $enrolled}}'
}

security_admin() {
  local groups group=""
  groups=" $(id -nG "$USERNAME" 2>/dev/null) "
  for g in wheel sudo admin; do
    if [[ $groups == *" $g "* ]]; then group=$g; break; fi
  done
  jq -nc --arg group "$group" '{admin: {sudo: ($group != ""), group: $group}}'
}

# ---------------------------------------------------------------- assembly

TOKEN_PATTERN='eyJ[A-Za-z0-9_-]{10,}\.|(^|[^A-Za-z0-9])(gh[opusr]_[A-Za-z0-9]{20,}|github_pat_|sk-(ant-|proj-)?[A-Za-z0-9_-]{20,}|hf_[A-Za-z0-9]{20,}|glpat-|AKIA[0-9A-Z]{16}|ya29\.|1//0[A-Za-z0-9_-]{20,}|xox[abp]-|A3-[A-Z0-9]{6}-[A-Z0-9]{5,})'

emit() { # final guard: never print a document that looks like it carries a token
  local doc=$1
  if grep -qE -- "$TOKEN_PATTERN" <<<"$doc"; then
    jq -nc --arg v "$PROBE_VERSION" '{schemaVersion: 1, probeVersion: $v, error: "redaction-guard"}'
  else
    printf '%s\n' "$doc"
  fi
}

run_parts() { # <kind> <tmpdir> <ids...>: run each part isolated, in parallel, under a timeout
  local kind=$1 tmp=$2 id; shift 2
  for id in "$@"; do
    (
      local t=$PROVIDER_TIMEOUT
      [[ $id == gpg ]] && t=$(( t > 5 ? t : 5 ))
      timeout -k 1 "$t" bash "$SELF" "--$kind" "$id" >"$tmp/$kind.$id.out" 2>/dev/null
      echo $? >"$tmp/$kind.$id.rc"
    ) &
  done
  wait
}

collect_errors() { # <kind> <section> <tmpdir> <ids...>
  local kind=$1 section=$2 tmp=$3 id rc; shift 3
  for id in "$@"; do
    rc=$(cat "$tmp/$kind.$id.rc" 2>/dev/null || echo 1)
    case $rc in
      0) ;;
      124|137) jq -nc --arg s "$section" --arg p "$id" '{section: $s, provider: $p, message: "timeout"}' ;;
      *) jq -nc --arg s "$section" --arg p "$id" '{section: $s, provider: $p, message: "failed"}' ;;
    esac
  done
}

# Fictional, fixed data for screenshots and demos (`demo` setting / --demo).
# Reads nothing from the machine.
demo_document() {
  jq -nc --arg v "$PROBE_VERSION" --argjson now "$NOW_MS" '
    def acct($p; $n; $src; $id; $plan; $st; $exp; $note):
      {id: ($p + ":" + $id), provider: $p, name: $n, source: $src, identity: $id, plan: $plan,
       status: $st, expiresEpochMs: $exp, note: $note};
    {schemaVersion: 1, probeVersion: $v, generatedAtMs: $now, demo: true,
     sections: ["user", "session", "accounts", "security"],
     user: {username: "alex", uid: 1000, host: "workstation", fullName: "Alex Rivera",
            fullNameSource: "gecos", initials: "AR", avatar: "", shell: "/usr/bin/bash",
            home: "/home/alex", groups: ["alex", "wheel"],
            git: {name: "Alex Rivera", email: "alex@example.com"}},
     session: {available: true, id: "2", loginEpochMs: ($now - 11520000), type: "wayland", class: "user",
               desktop: "Hyprland", service: "sddm", autologin: false, greeter: "sddm", seat: "seat0",
               tty: "tty1", vt: 1, remote: false, remoteHost: "", state: "active",
               bootEpochMs: ($now - 11640000),
               previousLogin: {epochMs: ($now - 172800000 - 5400000), tty: "tty1"}},
     accounts: [
       acct("github"; "GitHub"; "gh CLI · github.com"; "alexr"; ""; "connected"; null; ""),
       acct("google"; "Google"; "Google Chrome · Work"; "alex@example.com"; ""; "connected"; null; ""),
       acct("claude"; "Claude"; "Claude Code"; "alex@example.com"; "Max 5x"; "connected"; ($now + 2160000000); "Org: Example"),
       acct("openai"; "OpenAI"; "Codex CLI"; "alex@example.com"; "ChatGPT Plus"; "connected"; null; "Renews Nov 2"),
       acct("copilot"; "GitHub Copilot"; "Copilot CLI"; "alexr"; ""; "connected"; null; ""),
       acct("cursor"; "Cursor"; "Cursor"; "alex@example.com"; "Pro"; "connected"; null; ""),
       acct("azure"; "Azure"; "Azure CLI"; "alex@example.com"; ""; "connected"; null; "Subscription: Dev"),
       acct("cloudflare"; "Cloudflare"; "wrangler"; "OAuth session"; ""; "expiring"; ($now + 259200000); ""),
       acct("aws"; "AWS"; "aws config"; "2 profiles: default, prod"; ""; "expired"; ($now - 3600000); "SSO session expired"),
       acct("slack"; "Slack"; "Slack desktop"; "3 workspaces"; ""; "connected"; null; ""),
       acct("spotify"; "Spotify"; "Spotify"; "alexr"; ""; "connected"; null; ""),
       acct("steam"; "Steam"; "Steam"; "Alex (alexr)"; ""; "connected"; null; ""),
       acct("1password"; "1Password"; "1Password CLI"; "alex@example.com"; ""; "connected"; null; "my.1password.com")
     ],
     security: {ssh: {dirExists: true, keys: [{file: "id_ed25519.pub", type: "ED25519", bits: 256,
                       fingerprint: "SHA256:demo", comment: "alex@example.com"}]},
                gpg: {homeExists: true, checked: true, keys: []},
                keyring: {service: true, collection: true, locked: false, label: "Login"},
                fingerprint: {reader: true, fprintd: true, enrolled: 2},
                admin: {sudo: true, group: "wheel"}},
     errors: []}'
}

main() {
  local sections="all"
  if [[ ${USER_MENU_DEMO:-} == 1 ]]; then demo_document; exit 0; fi
  while (( $# )); do
    case $1 in
      --demo) demo_document; exit 0 ;;
      --provider)
        [[ $(type -t "provider_${2:-}") == function ]] && "provider_$2"
        exit 0 ;;
      --security)
        [[ $(type -t "security_${2:-}") == function ]] && "security_$2"
        exit 0 ;;
      --section) sections=${2:-all}; shift 2 ;;
      --version) echo "$PROBE_VERSION"; exit 0 ;;
      *) shift ;;
    esac
  done
  [[ $sections == all ]] && sections="user,session,accounts,security"

  local want=",$sections,"
  local user=null session=null accounts=null security=null errors="[]"
  # Global, not local: the EXIT trap runs after main has returned.
  PROBE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/user-menu-probe.XXXXXX") || PROBE_TMP=""
  trap '[[ -n ${PROBE_TMP:-} ]] && rm -rf -- "$PROBE_TMP"' EXIT
  trap 'exit 143' TERM INT
  local tmp=$PROBE_TMP

  [[ $want == *,user,* ]] && user=$(section_user 2>/dev/null)
  [[ $want == *,session,* ]] && session=$(section_session 2>/dev/null)

  local providers=("${PROVIDERS[@]}")
  if [[ -n ${USER_MENU_PROVIDERS:-} ]]; then
    local allow=",${USER_MENU_PROVIDERS// /},"
    providers=()
    for id in "${PROVIDERS[@]}"; do [[ $allow == *",$id,"* ]] && providers+=("$id"); done
  fi

  local err_lines=""
  if [[ -n $tmp && $want == *,accounts,* ]]; then
    run_parts provider "$tmp" "${providers[@]}"
    accounts=$(for id in "${providers[@]}"; do cat "$tmp/provider.$id.out" 2>/dev/null; done \
      | jq -sc '[.[] | objects]
          | reduce .[] as $r ([];
              (map(.provider + "\u0000" + .identity) | index($r.provider + "\u0000" + $r.identity)) as $i
              | if $r.identity != "" and $i != null
                then .[$i].source = ([.[$i].source, $r.source] | unique | join(", "))
                else . + [$r] end)' 2>/dev/null)
    err_lines+=$(collect_errors provider accounts "$tmp" "${providers[@]}")$'\n'
  fi

  if [[ -n $tmp && $want == *,security,* ]]; then
    run_parts security "$tmp" "${SECURITY[@]}"
    security=$(for id in "${SECURITY[@]}"; do cat "$tmp/security.$id.out" 2>/dev/null; done \
      | jq -sc '[.[] | objects] | add // {}' 2>/dev/null)
    err_lines+=$(collect_errors security security "$tmp" "${SECURITY[@]}")$'\n'
  fi

  errors=$(printf '%s' "$err_lines" | jq -sc '[.[] | objects]' 2>/dev/null)

  local doc
  doc=$(jq -nc --arg v "$PROBE_VERSION" --arg now "$NOW_MS" --arg sections "$sections" \
    --argjson user "${user:-null}" --argjson session "${session:-null}" \
    --argjson accounts "${accounts:-null}" --argjson security "${security:-null}" \
    --argjson errors "${errors:-[]}" '
    {schemaVersion: 1, probeVersion: $v, generatedAtMs: ($now | tonumber),
     sections: ($sections | split(",")), user: $user, session: $session,
     accounts: $accounts, security: $security, errors: $errors}
    | with_entries(select(.value != null))' 2>/dev/null)
  if [[ -z $doc ]]; then
    doc=$(jq -nc --arg v "$PROBE_VERSION" '{schemaVersion: 1, probeVersion: $v, error: "assembly-failed"}')
  fi
  emit "$doc"
}

main "$@"
exit 0
